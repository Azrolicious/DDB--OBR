{
  "manifest_version": 3,
  "name": "DDB-OBR Bridge",
  "version": "0.1.0",
  "description": "Lets the DDB-OBR Owlbear Rodeo extension read your D&D Beyond characters, monsters and encounters with your own D&D Beyond login.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "DDB-OBR Bridge",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "host_permissions": ["https://*.dndbeyond.com/*"],
  "content_scripts": [
    {
      "matches": [
        "https://azrolicious.github.io/DDB--OBR/*",
        "https://azrolicious.github.io/ddb--obr/*",
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*"
      ],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "ddb-obr-bridge@example.invalid",
      "strict_min_version": "121.0"
    }
  }
}
